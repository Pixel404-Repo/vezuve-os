# Animation de demarrage Vezuve : 135 images a 15 i/s
Window.SetBackgroundTopColor(0, 0, 0);
Window.SetBackgroundBottomColor(0, 0, 0);
N = 135;
W = Window.GetWidth();
H = Window.GetHeight();
for (i = 0; i < N; i++) {
  img = Image("f" + i + ".png");
  frames[i] = img.Scale(W, H);
}
sprite = Sprite();
sprite.SetX(Window.GetX());
sprite.SetY(Window.GetY());
tick = 0;
fun refresh() {
  idx = Math.Int(tick / 3.33);
  if (idx >= N) idx = N - 1;
  sprite.SetImage(frames[idx]);
  tick++;
}
Plymouth.SetRefreshFunction(refresh);
